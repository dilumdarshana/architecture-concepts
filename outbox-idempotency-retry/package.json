{
  "name": "express-resilience",
  "version": "1.0.0",
  "private": true,
  "description": "Outbox pattern, idempotency, and retry demo with Express + Prisma + BullMQ",
  "scripts": {
    "postinstall": "dotenv -e .env -- prisma generate",
    "dev": "dotenv -e .env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "dotenv -e .env -- prisma generate",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "prisma:studio": "pnpm exec dotenv -e .env -- prisma studio"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "dependencies": {
    "@bull-board/api": "^8.3.0",
    "@bull-board/express": "^8.3.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bullmq": "^5.81.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^11.0.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
