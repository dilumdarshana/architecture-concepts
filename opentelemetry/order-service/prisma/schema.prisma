generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id        String   @id @default(uuid())
  productId String
  quantity  Int
  status    String   @default("pending")
  createdAt DateTime @default(now())

  payments Payment[]
}

model Payment {
  id        String   @id @default(uuid())
  orderId   String
  amount    Decimal
  status    String   @default("pending")
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}
